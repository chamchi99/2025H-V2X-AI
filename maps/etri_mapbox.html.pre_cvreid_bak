// ============================================================
// REPLAY MODE — JSONL 로그를 video FPS로 재생
// ============================================================
const REPLAY_VIDEO_FPS = 30;
let replayRunning = false;
let replayTimer = null;

async function toggleReplay() {
  const btn = document.getElementById('replayBtn');
  const status = document.getElementById('replayStatus');
  if (replayRunning) {
    // 정지
    replayRunning = false;
    if (replayTimer) clearTimeout(replayTimer);
    btn.textContent = 'Replay 시작';
    status.textContent = '정지됨';
    return;
  }
  // 시작: 로그 fetch
  status.textContent = '로그 로딩 중...';
  let text;
  try {
    const r = await fetch('/outputs/cctv-traffic-log.jsonl?t=' + Date.now());
    if (!r.ok) { status.textContent = '로그 파일 없음'; return; }
    text = await r.text();
  } catch(e) { status.textContent = 'fetch 실패'; return; }
  const lines = text.trim().split('\n').filter(l => l);
  if (lines.length === 0) { status.textContent = '빈 로그'; return; }
  // 폴링 정지 (replay와 충돌 방지)
  if (isPolling) togglePolling();
  // 재생 준비
  replayRunning = true;
  btn.textContent = 'Replay 정지';
  const snapshots = lines.map(l => { try { return JSON.parse(l); } catch(e) { return null; }}).filter(s => s);
  if (snapshots.length === 0) { status.textContent = 'JSON 파싱 실패'; replayRunning = false; btn.textContent='Replay 시작'; return; }
  // frame_idx 기준 정렬
  snapshots.sort((a, b) => (a.frame_idx || 0) - (b.frame_idx || 0));
  const firstFrame = snapshots[0].frame_idx || 0;
  const lastFrame = snapshots[snapshots.length-1].frame_idx || 0;
  const totalFrames = lastFrame - firstFrame + 1;
  status.textContent = `재생 0/${snapshots.length} (총 ${(totalFrames/REPLAY_VIDEO_FPS).toFixed(1)}s)`;
  const replayStart = performance.now();
  let nextIdx = 0;
  function tick() {
    if (!replayRunning) return;
    const elapsed = (performance.now() - replayStart) / 1000;  // sec
    const currentFrame = Math.floor(elapsed * REPLAY_VIDEO_FPS) + firstFrame;
    // currentFrame까지의 모든 스냅샷 처리 (가장 최근 것만 표출)
    let applied = null;
    while (nextIdx < snapshots.length && snapshots[nextIdx].frame_idx <= currentFrame) {
      applied = snapshots[nextIdx];
      nextIdx++;
    }
    if (applied) {
      updateObjects({ traffic: applied.traffic });
      status.textContent = `재생 ${nextIdx}/${snapshots.length} (frame ${applied.frame_idx})`;
    }
    if (nextIdx >= snapshots.length) {
      // 완료
      replayRunning = false;
      document.getElementById('replayBtn').textContent = 'Replay 시작';
      status.textContent = `완료 (${snapshots.length} 프레임)`;
      return;
    }
    replayTimer = setTimeout(tick, 33);  // ~30 FPS UI update
  }
  tick();
}

function updateObjectUI() {
  const el = document.getElementById('objectList');
  if (liveObjects.length === 0) { el.innerHTML = '감지된 객체 없음'; return; }

  document.getElementById('liveIndicator').style.background = '#10b981';
  document.getElementById('liveStatus').textContent = `${liveObjects.length}개 | ${new Date().toLocaleTimeString()}`;

  el.innerHTML = liveObjects.map(o => {
    const cls = CLASS_NAMES[o.class] || 'car';
    const isPerson = (o.class === 0);
    const zone = o.ped_zone || null;
    const color = isPerson ? (PED_ZONE_COLORS[zone] || '#34d399') : (CLASS_COLORS[cls] || '#ef4444');
    const spd = (o.speed !== 999 && o.speed !== null) ? `${o.speed}km/h` : '';
    const stopBadge = (o.stop_duration >= 3) ? `<span style="color:#f59e0b;margin-left:4px">P${o.stop_duration}s</span>` : '';
    const occBadge = (o.lane_occupancy > 0) ? `<span style="color:#f472b6;margin-left:4px">${Math.round(o.lane_occupancy*100)}%</span>` : '';
    const zoneBadge = isPerson && zone ? `<span style="color:${color};margin-left:4px;font-size:9px">${PED_ZONE_KO[zone]||zone}</span>` : '';
    return `<div class="obj-row">
      <div class="status-dot" style="background:${color}"></div>
      <span style="color:${color};font-weight:700">${cls}</span>
      <span style="color:#64748b">#${o.id}</span>
      ${zoneBadge}
      <span style="margin-left:auto;color:#94a3b8">${spd}</span>${stopBadge}${occBadge}
    </div>`;
  }).join('');
}

