// GCP EDIT MODE: 드래그로 위치 조정 → 좌표 복사
// ============================================================
let editMode = false;
let gcpMarkers = [];

function toggleEditMode() {
  editMode = !editMode;
  const btn = document.getElementById('editBtn');
  const info = document.getElementById('gcpEditInfo');

  if (editMode) {
    btn.textContent = '편집 모드 OFF';
    btn.style.background = 'rgba(239,68,68,0.3)';
    info.textContent = '드래그하여 GCP 위치를 조정하세요';
    info.style.color = '#10b981';
    createDraggableGCPs();
    // 기존 GCP 레이어 숨기기
    try { map.setLayoutProperty('gcp-circle','visibility','none'); } catch(e){}
    try { map.setLayoutProperty('gcp-label','visibility','none'); } catch(e){}
  } else {
    btn.textContent = '편집 모드 ON';
    btn.style.background = '';
    info.textContent = '편집 모드에서 GCP를 드래그하세요';
    info.style.color = '#64748b';
    removeDraggableGCPs();
    try { map.setLayoutProperty('gcp-circle','visibility','visible'); } catch(e){}
    try { map.setLayoutProperty('gcp-label','visibility','visible'); } catch(e){}
  }
}

function createDraggableGCPs() {
  removeDraggableGCPs();

  cameras.forEach((cam, ci) => {
    cam.gcps.forEach((gcp, gi) => {
      // 마커 엘리먼트
      const el = document.createElement('div');
      el.style.cssText = `
        width:18px; height:18px; border-radius:50%;
        background:${cam.color}; border:2.5px solid white;
        cursor:grab; box-shadow:0 0 8px ${cam.color};
        display:flex; align-items:center; justify-content:center;
        font-size:8px; font-weight:700; color:white;
        font-family:'JetBrains Mono',monospace;
      `;
      el.textContent = gi + 1;

      const marker = new mapboxgl.Marker({ element:el, draggable:true })
        .setLngLat([gcp.lon, gcp.lat])
        .addTo(map);

      // 드래그 이벤트
      marker.on('drag', () => {
        const pos = marker.getLngLat();
        // 실시간으로 cameras 데이터 업데이트
        cameras[ci].gcps[gi].lat = pos.lat;
        cameras[ci].gcps[gi].lon = pos.lng;
        updateGCPInfo(ci, gi, pos.lat, pos.lng);
      });

      marker.on('dragend', () => {
        const pos = marker.getLngLat();
        cameras[ci].gcps[gi].lat = pos.lat;
        cameras[ci].gcps[gi].lon = pos.lng;
        // FOV 소스도 갱신
        updateFOVSource();
      });

      marker._camIdx = ci;
      marker._gcpIdx = gi;
      gcpMarkers.push(marker);
    });
  });
}

function removeDraggableGCPs() {
  gcpMarkers.forEach(m => m.remove());
  gcpMarkers = [];
}

function updateGCPInfo(ci, gi, lat, lng) {
  const info = document.getElementById('gcpEditInfo');
  info.innerHTML = `<span style="color:${cameras[ci].color}">${cameras[ci].name}</span> GCP-${gi+1}<br>` +
    `lat: <span style="color:#10b981">${lat.toFixed(8)}</span><br>` +
    `lon: <span style="color:#10b981">${lng.toFixed(8)}</span>`;
}

function updateFOVSource() {
  // GCP를 바탕으로 FOV 갱신할 수도 있지만, 일단 기존 FOV 유지
  const gcpFeatures = [];
  cameras.forEach(cam => {
    cam.gcps.forEach((g, gi) => {
      gcpFeatures.push({
        type:'Feature',
        properties:{ label:`${cam.name.split(' ')[1]}-${gi+1}`, color:cam.color },
        geometry:{ type:'Point', coordinates:[g.lon, g.lat] }
      });
    });
  });
  try {
    map.getSource('gcps').setData({ type:'FeatureCollection', features:gcpFeatures });
  } catch(e){}
}

