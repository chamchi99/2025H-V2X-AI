    setTimeout(() => { info.textContent = '편집 모드에서 GCP를 드래그하세요'; }, 2000);
  }).catch(() => {
    // 클립보드 실패 시 선택만
    const range = document.createRange();
    range.selectNode(pre);
    window.getSelection().removeAllRanges();
    window.getSelection().addRange(range);
  });
}

// ============================================================
// ROI 그리기: 지도 클릭으로 꼭짓점 추가 → GPS 폴리곤 좌표 복사
// ============================================================
let roiMode = false;
let roiPoints = [];   // [{lat,lon}]
let roiMarkers = [];

function roiGeoJSON() {
  const coords = roiPoints.map(p => [p.lon, p.lat]);
  const feats = [];
  if (coords.length >= 3) {
    feats.push({ type:'Feature', geometry:{ type:'Polygon', coordinates:[coords.concat([coords[0]])] } });
  } else if (coords.length === 2) {
    feats.push({ type:'Feature', geometry:{ type:'LineString', coordinates:coords } });
  }
  return { type:'FeatureCollection', features:feats };
}
function ensureRoiLayer() {
  if (map.getSource('roi-draw')) return;
  map.addSource('roi-draw', { type:'geojson', data:roiGeoJSON() });
  map.addLayer({ id:'roi-fill', type:'fill', source:'roi-draw',
    paint:{ 'fill-color':'#ef4444', 'fill-opacity':0.18 } });
  map.addLayer({ id:'roi-line', type:'line', source:'roi-draw',
    paint:{ 'line-color':'#ef4444', 'line-width':2 } });
}
function redrawRoi() {
  ensureRoiLayer();
  map.getSource('roi-draw').setData(roiGeoJSON());
  document.getElementById('roiInfo').textContent = `꼭짓점 ${roiPoints.length}개` + (roiMode ? ' (그리는 중)' : '');
}
function addRoiMarker(idx) {
  const p = roiPoints[idx];
  const el = document.createElement('div');
  el.style.cssText = 'width:12px;height:12px;border-radius:50%;background:#ef4444;border:2px solid #fff;cursor:move;box-shadow:0 0 4px rgba(0,0,0,0.6);';
  const m = new mapboxgl.Marker({ element:el, draggable:true }).setLngLat([p.lon, p.lat]).addTo(map);
  m.on('drag', () => { const ll=m.getLngLat(); roiPoints[idx]={lat:ll.lat,lon:ll.lng}; redrawRoi(); });
  roiMarkers.push(m);
}
function toggleRoiMode() {
  roiMode = !roiMode;
  const btn = document.getElementById('roiBtn');
  btn.textContent = roiMode ? 'ROI 그리기 OFF' : 'ROI 그리기 ON';
  btn.style.background = roiMode ? 'rgba(239,68,68,0.3)' : '';
  map.getCanvas().style.cursor = roiMode ? 'crosshair' : '';
  redrawRoi();
}
function undoRoiPoint() {
  if (!roiPoints.length) return;
  roiPoints.pop();
  const m = roiMarkers.pop(); if (m) m.remove();
  redrawRoi();
}
function clearRoi() {
  roiPoints = [];
  roiMarkers.forEach(m=>m.remove()); roiMarkers=[];
  redrawRoi();
}
map.on('click', (e) => {
  if (!roiMode) return;
  roiPoints.push({ lat:e.lngLat.lat, lon:e.lngLat.lng });
  addRoiMarker(roiPoints.length-1);
  redrawRoi();
});
function exportRoi() {
  let py = '# overlap dedup ROI (폴리곤, 시계/반시계 순서)\nOVERLAP_ROI = [\n';
  roiPoints.forEach(p => { py += `    (${p.lat.toFixed(7)}, ${p.lon.toFixed(7)}),\n`; });
  py += ']\n';
  const pre = document.getElementById('roiExport');
  pre.style.display = 'block';
  pre.textContent = py;
  navigator.clipboard.writeText(py).then(()=>{
    document.getElementById('roiInfo').innerHTML = '<span style="color:#10b981">✓ 클립보드 복사됨!</span>';
  }).catch(()=>{});
}
</script>
