  let text = '';
  cameras.forEach(cam => {
    text += `// ${cam.name}\n`;
    text += `gcps: [\n`;
    cam.gcps.forEach((g, gi) => {
      text += `  {lat:${g.lat.toFixed(8)}, lon:${g.lon.toFixed(8)}}, // GCP-${gi+1}\n`;
