async function loadJSON() {
  try {
    const r = await fetch('/outputs/cctv-traffic.json?t=' + Date.now());
    if (!r.ok) return;
    const text = await r.text();
    let data;
    try { data = JSON.parse(text); } catch(e) { return; }
    // 매 폴링마다 갱신 (정차시간·속도·점유율 등 수치 변화 실시간 반영).
    // 예전엔 위치 변화 없으면 skip했으나(깜빡임 방지용), 깜빡임은 라벨의
    // text-allow-overlap 으로 별도 해결됨 → 억제 불필요. 위치는 RAF 보간으로 부드럽게.
    updateObjects(data);
  } catch(e) {}
}

